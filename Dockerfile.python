# Dockerfile per l'applicazione Python Streamlit (DocuMorph AI)
FROM python:3.10-slim

WORKDIR /app

# Installazione strumenti di sistema minimi
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Installazione dipendenze Python
COPY python_app/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copia sorgenti Python
COPY python_app/ ./

EXPOSE 8501

ENV PYTHONUNBUFFERED=1

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "web_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
